<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <PackageId>MarkdownUtil</PackageId>
    <ToolCommandName>mdu</ToolCommandName>
    <AssemblyName>mdu</AssemblyName>
    <Authors>Jan Ruhlaender</Authors>
    <Copyright>©2023 Jan Ruhlaender</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>MarkdownUtil has reached end of life. This final release explains the migration to mdu, the successor package.</Description>
    <PackageTags>Markdown Static-Website-Generator</PackageTags>
    <RepositoryUrl>https://github.com/capjan/markdownutil-sunset</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Res\notice.json" LogicalName="notice.json" />
  </ItemGroup>

</Project>
